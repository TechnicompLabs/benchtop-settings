#%PAM-1.0
# Technicomp Benchtop Linux: an enrolled fingerprint first, then openSUSE's own
# sudo-i configuration, which is included from /usr/lib/pam.d unchanged. Users
# without a fingerprint are asked for their password at once.
-auth    sufficient     pam_fprintd.so
auth     include        /usr/lib/pam.d/sudo-i
account  include        /usr/lib/pam.d/sudo-i
password include        /usr/lib/pam.d/sudo-i
session  include        /usr/lib/pam.d/sudo-i
