#%PAM-1.0
# Technicomp Benchtop Linux: an enrolled fingerprint first, then openSUSE's own
# polkit-1 configuration, which is included from /usr/lib/pam.d unchanged. Users
# without a fingerprint are asked for their password at once.
-auth    sufficient     pam_fprintd.so
auth     include        /usr/lib/pam.d/polkit-1
account  include        /usr/lib/pam.d/polkit-1
password include        /usr/lib/pam.d/polkit-1
session  include        /usr/lib/pam.d/polkit-1
