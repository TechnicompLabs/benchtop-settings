# TechniComp Benchtop Linux packages: the OBS project home:technicomp:benchtop.
# priority=90 puts it above the openSUSE repositories (zypper's default is 99),
# so TCBL builds win over Tumbleweed packages of the same name.
[repo-tcbl]
name=TechniComp Benchtop Linux
enabled=1
autorefresh=1
baseurl=https://download.opensuse.org/repositories/home:/technicomp:/benchtop/openSUSE_Tumbleweed/
type=rpm-md
priority=90
gpgcheck=1
gpgkey=https://download.opensuse.org/repositories/home:/technicomp:/benchtop/openSUSE_Tumbleweed/repodata/repomd.xml.key
