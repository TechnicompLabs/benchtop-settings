# Technicomp Benchtop Linux: services of an immutable, transactional system, as
# openSUSE Aeon's presets enable them; openSUSE's own presets are written for a
# regular Tumbleweed install. systemd uses the first line that matches a unit,
# so this file sorts before openSUSE's 90-, 95- and 99- preset files.

# daily update into a new snapshot (see 90-tcbl-reboot.conf for the restart)
enable transactional-update.timer
# creates the /var directories of packages installed by transactional-update
enable create-dirs-from-rpmdb.service
# rolls back to the previous snapshot if the first boot after an update fails
enable health-checker.service
# adds x86-64-v3 optimized libraries after updates, on CPUs that support them
enable x86-64-v3-libraries.service
# records hardware errors (machine checks, PCIe AER, memory and disk errors) in
# /var/lib/rasdaemon, for ras-mc-ctl; openSUSE's presets leave it off
enable rasdaemon.service
# NetworkManager, which openSUSE's installers enable but its presets do not
enable NetworkManager.service
# DNS through systemd-resolved (NetworkManager/conf.d/90-tcbl-dns.conf); openSUSE's
# presets leave it off
enable systemd-resolved.service
# swap compressed in memory (systemd-zram-service); openSUSE's presets leave it
# off
enable zramswap.service
# process priorities by profile, and for the focused application
# (system76-scheduler; 90-tcbl-gnome-shell.gschema.override enables the
# extension that reports it)
enable com.system76.Scheduler.service

# graphical logins only: no text login on the first console (see
# logind.conf.d/90-tcbl-no-text-login.conf for the others)
disable getty@.service
