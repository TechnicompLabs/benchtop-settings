# TechniComp Benchtop Linux: restart 5 seconds after a kernel panic, but only
# once the boot has completed. The kernel command line sets panic=0 (the image's
# config.sh), so a snapshot that panics while it starts stops with the message
# on screen instead of restarting into itself: after an update, sdbootutil makes
# the new snapshot's boot entry the fixed default, and systemd-boot keeps
# booting that entry even when its boot-count tries are used up.
# boot-complete.target is reached only when health-checker's checks pass.
[Unit]
Description=Restart 5 seconds after a kernel panic, once the boot has completed
Requires=boot-complete.target
After=boot-complete.target

[Service]
Type=oneshot
ExecStart=/usr/sbin/sysctl -q -w kernel.panic=5

[Install]
WantedBy=multi-user.target
