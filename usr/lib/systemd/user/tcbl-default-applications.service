# Technicomp Benchtop Linux: the default applications (once) and the system's
# themes in the user's Flatpak installation, at every login; see
# /usr/libexec/tcbl/default-applications. While a step that needs the network
# fails (at the first login Wi-Fi is often not set up yet), it tries again: after
# 5 minutes at first, the wait growing to an hour, for as long as the session
# lasts, and again at the next login.
[Unit]
Description=Default applications and themes in the user's Flatpak installation
# not for system accounts (the login screen, GNOME's initial setup)
ConditionUser=!@system
# Flathub is added to the user's installation first
After=configure-user-flathub.service

[Service]
Type=oneshot
ExecStart=/usr/libexec/tcbl/default-applications
Restart=on-failure
RestartSec=5min
RestartSteps=4
RestartMaxDelaySec=1h

[Install]
WantedBy=default.target
