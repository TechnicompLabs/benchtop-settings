# Technicomp Benchtop Linux: runs tcbl-themes.service daily, so that KDE
# runtimes installed since the last login get Kvantum, and updated Kvantum
# themes are copied again.
[Unit]
Description=Themes for the user's Flatpak applications, daily

[Timer]
OnCalendar=daily
RandomizedDelaySec=1h
Persistent=true

[Install]
WantedBy=timers.target
