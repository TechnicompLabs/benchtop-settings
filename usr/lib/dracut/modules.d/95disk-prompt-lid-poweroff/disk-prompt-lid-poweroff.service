# Technicomp Benchtop Linux: in the initrd, powers the computer off at the disk
# prompt when the lid has been closed on battery for 3 minutes; see
# /usr/bin/disk-prompt-lid-poweroff. It ends when the root file system's device is
# available, that is, once the disk is unlocked.
[Unit]
Description=Power off at the disk prompt when the lid is closed on battery
DefaultDependencies=no
Conflicts=initrd-switch-root.target shutdown.target
Before=initrd-switch-root.target shutdown.target

[Service]
Type=simple
ExecStart=/usr/bin/disk-prompt-lid-poweroff
