# Technicomp Benchtop Linux: rescan the PCI buses shortly after a Thunderbolt or
# USB4 device is authorized, because pciehp sometimes misses the devices behind
# a new PCIe tunnel (docks on AMD USB4 laptops among them). A rescan that finds
# nothing new changes nothing. Turn it off with:
#     systemctl mask pci-rescan.service
ACTION=="add|change", SUBSYSTEM=="thunderbolt", ENV{DEVTYPE}=="thunderbolt_device", ATTR{authorized}=="1", RUN+="/usr/bin/systemctl --no-block start pci-rescan.service"
