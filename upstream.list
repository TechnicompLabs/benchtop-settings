# Files that tc-benchtop-settings copies unchanged from other projects, and the
# files of those projects that were reviewed and not copied. UPSTREAM.md gives
# the reasons. scripts/check-upstream compares this list with each project's
# current version; scripts/check-upstream --apply copies the changes in.
#
#   source NAME URL BRANCH COMMIT LICENSE   the project, and the commit last compared
#   file   NAME UPSTREAM-PATH LOCAL-PATH    a copied file; the two must be identical
#   seen   NAME UPSTREAM-PATH BLOB          reviewed and not copied, at that version
#   watch  NAME UPSTREAM-DIRECTORY          report files added there upstream

# game-devices-udev: controllers and VR headsets. Installed as 71-<file>, the
# name its meson build gives them (udev_priority 71). pop-os/game-devices-udev
# packages the same rules from this repository.
source gdu https://codeberg.org/fabiscafe/game-devices-udev.git main f0c821eb3f1c3e87f3a6b2d9a5400905f32f84c8 MIT
